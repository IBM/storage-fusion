# macOS binary metadata files
.DS_Store
*.DS_Store
._*
.Trashes

# Editor and OS temporary files
*.swp
*.swo
*~
.idea/
.vscode/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo

# Environment / secrets files — NEVER commit these
*.env
!*.env.example

