# aiq-fusion.env.example — v2 (multi-store + OpenShift OAuth)
# ──────────────────────────────────────────────────────────────────────────────
# Copy to aiq-fusion.env, fill in all values, then run:
#   ./scripts/deploy-all.sh
# ──────────────────────────────────────────────────────────────────────────────

# ── AI-Q repository ───────────────────────────────────────────────────────────
# Path where `git clone https://github.com/NVIDIA-AI-Blueprints/aiq.git` lives.
AIQ_REPO_DIR="/path/to/aiq"

# Specific commit SHA to pin. Patches and integration are built on top of this commit.
AIQ_COMMIT="525ba8f0f3d0593dcf43ae917c2bf4f2ae13a8a5"

# Note: STORAGE_FUSION_REPO_DIR is NOT needed — the scripts automatically use
# the src/ directory that lives alongside them in this repository.

# ── Container image ───────────────────────────────────────────────────────────
# Use the OpenShift integrated registry (recommended) or an external registry.
# OpenShift integrated registry example:
#   IMAGE_REGISTRY="image-registry.openshift-image-registry.svc:5000"
#   IMAGE_NAMESPACE="ns-aiq"
IMAGE_REGISTRY=""
IMAGE_NAMESPACE="ns-aiq"

# Backend image tag (built by OpenShift BuildConfig from aiq branch with patches)
BACKEND_IMAGE_TAG="fusion-cas"

# Frontend image tag
FRONTEND_IMAGE_TAG="openshift-auth"

# Container tool for local builds (docker or podman). Only used as fallback
# when OpenShift BuildConfig is not available.
CONTAINER_TOOL="docker"

# ── NVIDIA NGC ────────────────────────────────────────────────────────────────
NGC_API_KEY="your-ngc-api-key-here"

# ── Tavily (web search) ───────────────────────────────────────────────────────
TAVILY_API_KEY="your-tavily-api-key-here"

# ── IBM Fusion CAS ────────────────────────────────────────────────────────────
# Base URL — get from: oc get route -n ibm-cas  (prepend https://)
FUSION_CAS_URL="https://ibm-cas-ibm-cas.apps.YOURCLUSTER"

# Bearer token — from OpenShift web console → username → Copy login command → Display Token
FUSION_CAS_TOKEN="your-token-here"

# Set to "false" for clusters with self-signed TLS certificates.
FUSION_VERIFY_SSL="false"

# ── Vector stores (v2 multi-store) ────────────────────────────────────────────
# Exact store names from Fusion UI → CAS → Data Stores (case-sensitive).
# Add more FUSION_VECTOR_STORE_N pairs as needed.
FUSION_VECTOR_STORE_1="your-first-vector-store-name"
FUSION_VECTOR_STORE_1_LABEL="Farming"        # Display label in AI-Q UI

FUSION_VECTOR_STORE_2="your-second-vector-store-name"
FUSION_VECTOR_STORE_2_LABEL="Assistant"      # Display label in AI-Q UI

# ── OpenShift OAuth ───────────────────────────────────────────────────────────
# Cluster apps domain (everything after "apps." in your route hostnames).
CLUSTER_DOMAIN="apps.YOURCLUSTER"

# OAuthClient name — must match the OAuthClient manifest created by 03-setup-secrets-and-token.sh
OAUTH_CLIENT_ID="aiq-nextauth"

# Generated by 03-setup-secrets-and-token.sh automatically if left blank.
# To generate manually: openssl rand -hex 32
OAUTH_CLIENT_SECRET=""

# Generated by 03-setup-secrets-and-token.sh automatically if left blank.
# To generate manually: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Postgres credentials ──────────────────────────────────────────────────────
# Default values match the aiq-postgres Helm deployment (aiq / aiq_dev).
# Override only if you changed them in values.yaml.
DB_USER_NAME="aiq"
DB_USER_PASSWORD="aiq_dev"

# ── Kubernetes / AI-Q deployment ─────────────────────────────────────────────
AIQ_NAMESPACE="ns-aiq"

# Namespace on the Fusion CAS OpenShift cluster for SA token generation.
FUSION_CAS_OCP_NAMESPACE="ibm-cas"

# Git repository details for OpenShift BuildConfig (recommended build method).
AIQ_GIT_URI=""
AIQ_GIT_REF="main"    # branch, tag, or commit SHA of your fork with patches applied

# Registry push secret name (used by BuildConfig to push the built image).
REGISTRY_PUSH_SECRET=""
