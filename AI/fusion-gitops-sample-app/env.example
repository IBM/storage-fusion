# OpenShift Cluster Configuration
OCP_SERVER=<OCP_SERVER>
OCP_TOKEN=<OCP_TOKEN>

# ── CAS Configuration (RAG mode) ─────────────────────────────────────────────
CAS_ENDPOINT=<CAS_ENDPOINT>
CAS_API_KEY=<CAS_API_KEY>
CAS_VECTOR_STORE_ID=<CAS_VECTOR_STORE_ID>  # Vector store ID (required for REST API)
CAS_USE_MCP=false  # Use MCP protocol (true) or REST API (false) - REST is actual format

# ── Model Gateway Configuration (RAG mode) ───────────────────────────────────
MODEL_GATEWAY_ENDPOINT=<MODEL_GATEWAY_ENDPOINT>
MODEL_GATEWAY_API_KEY=<MODEL_GATEWAY_API_KEY>  # Bearer token for authentication
MODEL_NAME=<MODEL_NAME>  # Model name to use (granite, mistral, etc.)
MODEL_GATEWAY_VERIFY_SSL=false  # Set to false for self-signed OpenShift Route certificates

# ── CPU Multi-Model Configuration (CPU mode) ─────────────────────────────────
# KServe InferenceServices in namespace deploy-models-cpu on the local cluster.
# URL pattern: https://<model-name>-predictor.<namespace>.svc.cluster.local:8443
#
# Chat model (general Q&A — fallback task)
MODEL_URL_CHAT=https://qwen2-5-1-5b-cpu-predictor.deploy-models-cpu.svc.cluster.local:8443
MODEL_ID_CHAT=qwen2-5-1-5b-cpu
MODEL_TOKEN_CHAT=<bearer-token-from-external-access-token-qwen2-5-1-5b-cpu-sa>

# Code model (code generation / debugging)
MODEL_URL_CODE=https://qwen2-5-coder-1-5b-cpu-predictor.deploy-models-cpu.svc.cluster.local:8443
MODEL_ID_CODE=qwen2-5-coder-1-5b-cpu
MODEL_TOKEN_CODE=<bearer-token-from-external-access-token-qwen2-5-coder-1-5b-cpu-sa>

# Summarize model (text condensation / key-point extraction)
MODEL_URL_SUMMARIZE=https://smollm2-1-7b-cpu-predictor.deploy-models-cpu.svc.cluster.local:8443
MODEL_ID_SUMMARIZE=smollm2-1-7b-cpu
MODEL_TOKEN_SUMMARIZE=<bearer-token-from-external-access-token-smollm2-1-7b-cpu-sa>

# Inference timeout in seconds (shared by all three CPU models)
INFERENCE_TIMEOUT_S=300

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# ── GitOps ────────────────────────────────────────────────────────────────────
GITOPS_REPO_URL=<GITOPS_REPO_URL>
GITOPS_BRANCH=main
