# ============================================
# IBM Fusion CAS Assistant - Backend Configuration
# ============================================

# LLM Configuration — REQUIRED, no defaults.
# This app works with any OpenAI-compatible /v1/chat/completions API.
# Uncomment and fill in ONE of the blocks below.
#
# --- NVIDIA NIM (port-forward) ---
# LLM_BASE_URL=http://localhost:8001
# LLM_MODEL=meta/llama-3.1-8b-instruct
#
# --- Local Ollama ---
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2:3b     # ~2 GB, runs on most laptops; use llama3.1:8b for better quality (needs 16 GB RAM+)
#
# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=300
# LLM_API_KEY=                 # set if your LLM service requires authentication

# RAG Settings
# Number of results fetched from CAS per question. The actual fetch is this
# value * 2 (see api_server.py), so RAG_MAX_RESULTS=10 fetches 20 raw chunks
# before filtering. Raise this if summary/headline chunks are not being
# returned (symptoms: county-level breakdowns instead of totals, daily rates
# instead of headline counts).
RAG_MAX_RESULTS=10
# Minimum score for a chunk to be included at all.
# Raise this to cut low-confidence chunks from all documents.
RAG_MIN_SCORE=0.1
RAG_MAX_CHUNK_CHARS=0
# Dominant-source gap: any source whose best score is more than this value
# below the top-scoring source is dropped entirely.
# Lower = more aggressive cross-document filtering.
# 0.09 balances contamination prevention with avoiding over-filtering of
# legitimate secondary chunks (e.g. a different state doc for the same event).
# Set to 0.0 to disable the filter completely.
RAG_DOMINANT_GAP=0.09

# LLM response token budget.
# 300 gives the model enough room to reason about dense infographic chunks
# before committing to a value. 150 is too tight for multi-value chunks and
# causes the model to grab the first plausible number rather than the correct one.
LLM_MAX_TOKENS=300

# Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# CAS Request Timeout (seconds)
CAS_TIMEOUT=30

# SSL verification for CAS requests.
# Set to true only if your CAS host has a valid, trusted certificate installed.
# Most cluster-internal deployments should leave this as false.
CAS_VERIFY_SSL=false
