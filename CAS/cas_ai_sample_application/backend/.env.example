# ============================================
# IBM Fusion CAS Assistant - Backend Configuration
# ============================================

# LLM Configuration — REQUIRED, no defaults.
# This app works with any OpenAI-compatible /v1/chat/completions API.
# Uncomment and fill in ONE of the blocks below.
#
# --- NVIDIA NIM (port-forward) ---
# LLM_BASE_URL=http://localhost:8001
# LLM_MODEL=meta/llama-3.1-8b-instruct
#
# --- Local Ollama ---
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2:3b     # ~2 GB, runs on most laptops; use llama3.1:8b for better quality (needs 16 GB RAM+)
#
# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=300
# LLM_API_KEY=                 # set if your LLM service requires authentication

# RAG Settings
# Number of results fetched from CAS per question. The actual fetch is this
# value * 2 (see api_server.py), so RAG_MAX_RESULTS=10 fetches 20 raw chunks
# before filtering. Raise this if summary/headline chunks are not being
# returned (symptoms: county-level breakdowns instead of totals, daily rates
# instead of headline counts).
RAG_MAX_RESULTS=10
# Minimum score for a chunk to be included at all.
# Raise this to cut low-confidence chunks from all documents.
RAG_MIN_SCORE=0.1
RAG_MAX_CHUNK_CHARS=0
# Dominant-source gap: any source whose best score is more than this value
# below the top-scoring source is dropped entirely.
# Lower = more aggressive cross-document filtering.
# 0.15 is more permissive and keeps more near-matching chunks when follow-up
# queries are short, fragmentary, or typo-heavy.
# Set to 0.0 to disable the filter completely.
RAG_DOMINANT_GAP=0.15

# Retrieval loop settings.
# RETRIEVAL_LOOP_MAX_ITER controls how many times the retrieval loop may
# re-fetch before forcing a final answer.  Default is 2.
# RETRIEVAL_LOOP_MAX_ITER=2
#
# FACT_CHECK_ENABLED — whether a second LLM verification pass is run on
# each answer before it is returned to the user.
#
#   true  (default) — the verifier re-reads the chunks and the draft answer;
#     if it spots an error it emits [RETRY] to trigger a re-fetch, or rewrites
#     the answer into the required FULL_ANSWER / [SOURCE: N] format.
#
#   false — the retrieval-loop answer is returned as-is.  Saves one LLM
#     round-trip per query (~50 % fewer LLM calls when every answer is
#     well-formed) at the cost of skipping the extra accuracy check.
#
#   TO DISABLE: add the line below (or export it in your shell):
#     FACT_CHECK_ENABLED=false
#
#   TO RE-ENABLE: remove that line or set FACT_CHECK_ENABLED=true
# FACT_CHECK_ENABLED=true

# TOOL_ROUTER_ENABLED — whether a dedicated LLM call runs before the retrieval
# loop to select the best tool for the question's domain.
#
#   true  (default) — a small focused prompt (tool_router_prompt.md) is sent to
#     the LLM before the first fetch.  The model outputs one tool name and the
#     loop starts with that tool.  Adds one fast LLM round-trip (max_tokens=10)
#     but correctly routes out-of-domain questions (e.g. weather) away from CAS.
#     Skipped automatically when only one tool is registered.
#
#   false — the loop always starts with the default tool (cas).  Zero extra
#     latency.  Use this if you only have CAS registered and don't need routing,
#     or if your LLM is too small to follow even the router prompt reliably.
#
#   TO DISABLE: add the line below (or export it in your shell):
#     TOOL_ROUTER_ENABLED=false
#
#   TO RE-ENABLE: remove that line or set TOOL_ROUTER_ENABLED=true
# TOOL_ROUTER_ENABLED=true

# LLM response token budget.
# 300 gives the model enough room to reason about dense infographic chunks
# before committing to a value. 150 is too tight for multi-value chunks and
# causes the model to grab the first plausible number rather than the correct one.
LLM_MAX_TOKENS=300

# Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security
# IMPORTANT FOR PRODUCTION: update CORS_ORIGINS and ALLOWED_HOSTS to match your
# deployed frontend hostname and backend hostname respectively.
# Leaving these at the localhost defaults will block all browser requests from
# any real domain and make the app appear broken with no visible error.
#
# Examples:
#   CORS_ORIGINS=https://myapp.example.com
#   ALLOWED_HOSTS=myapp-api.example.com
#
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# CAS Request Timeout (seconds)
CAS_TIMEOUT=30

# SSL verification for CAS requests.
# Set to true only if your CAS host has a valid, trusted certificate installed.
# Most cluster-internal deployments should leave this as false.
CAS_VERIFY_SSL=false

# Session handling (in-memory, single-replica — see README for tradeoffs)
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SESSION_ENABLED — master on/off switch                                 │
# │                                                                         │
# │  true  (default) — conversation history is stored, follow-up questions  │
# │    are rewritten against prior context, and the TTL sweep task runs.    │
# │                                                                         │
# │  false — every request is a fresh conversation.  Nothing is stored,     │
# │    no background task starts, and the DELETE /api/session/* endpoint    │
# │    becomes a no-op.  Use this for stateless / multi-replica deploys     │
# │    or during local development when you don't want history rewriting    │
# │    your queries.                                                         │
# │                                                                         │
# │  TO DISABLE:  add the line below (or export it in your shell):          │
# │    SESSION_ENABLED=false                                                 │
# │                                                                         │
# │  TO RE-ENABLE: remove that line or set SESSION_ENABLED=true             │
# └─────────────────────────────────────────────────────────────────────────┘
# SESSION_ENABLED=true
#
# Memory budget for stored conversation history (running summary + all turns).
# Calibrated for Llama 3.1 8B (128k context window):
#   128k total  –  ~5k for system prompt + chunks  –  headroom  ≈  25k for history.
#   Approximate: 1 token ≈ 4 English chars, so 25k tokens ≈ 100k chars ≈ ~5 questions.
# Compaction fires at 80% of budget (20k tokens / ~80k chars) and folds old turns
# into a running summary, keeping the last SESSION_KEEP_TURNS turns verbatim.
#
# SESSION_MAX_CONTEXT_TOKENS=25000
# SESSION_COMPACT_THRESHOLD=0.80
# SESSION_KEEP_TURNS=4
