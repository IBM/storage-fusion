      "pluginVersion": "12.2.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace(ALERTS{alertname=~\"SwitchMemoryHigh|SwitchMemoryCritical|SwitchCPUHigh|SwitchCPUCritical|SwitchTemperatureHigh|SwitchTemperatureCritical\"}, \"service\", \"$1\", \"service\", \"snmp-exporter-(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace(100 * (memTotalReal - memAvailReal) / memTotalReal, \"service\", \"$1\", \"service\", \"snmp-exporter-(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace(100 - ssCpuIdle, \"service\", \"$1\", \"service\", \"snmp-exporter-(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace(max by (service) ((psu1TempOrAmbientTemp / 10) or (psu2Temp / 10) or (cpuCoreSensor0 / 10) or (cpuCoreSensor1 / 10) or (mainBoardAmbientSensor / 10) or (asicTempSensor / 10)), \"service\", \"$1\", \"service\", \"snmp-exporter-(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "📋 Alert Details (No active alerts - showing current metrics only)",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "prometheus": true,
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "service": 0,
              "alertname": 1,
              "severity": 2,
              "alertstate": 3,
              "alert_type": 4,
              "component": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "service": "Switch",
              "severity": "Severity",
              "alert_type": "Type",
              "component": "Component",
              "Value #B": "Memory %",
              "Value #C": "CPU %",
              "Value #D": "Temperature °C"
            }
          }
        }
      ],
      "type": "table"
